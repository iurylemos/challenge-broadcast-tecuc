rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && resource.data.ownerId == request.auth.uid; }
    function creatingAsOwner() { return signedIn() && request.resource.data.ownerId == request.auth.uid; }
    function ownerUnchanged() { return request.resource.data.ownerId == resource.data.ownerId; }
    function ownsConnection(id) {
      return get(/databases/$(db)/documents/connections/$(id)).data.ownerId == request.auth.uid;
    }

    match /connections/{id} {
      allow read, delete: if isOwner();
      allow create: if creatingAsOwner();
      allow update: if isOwner() && ownerUnchanged();
    }

    match /contacts/{id} {
      allow read, delete: if isOwner();
      allow create: if creatingAsOwner() && ownsConnection(request.resource.data.connectionId);
      allow update: if isOwner() && ownerUnchanged()
        && request.resource.data.connectionId == resource.data.connectionId;
    }

    match /messages/{id} {
      allow read, delete: if isOwner();
      allow create: if creatingAsOwner()
        && ownsConnection(request.resource.data.connectionId)
        && request.resource.data.status in ['scheduled', 'sent'];
      allow update: if isOwner() && ownerUnchanged()
        && request.resource.data.connectionId == resource.data.connectionId
        && resource.data.status == 'scheduled'; // enviada é imutável
    }
  }
}